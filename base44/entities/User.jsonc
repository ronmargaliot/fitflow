{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique username for the user"
    },
    "bio": {
      "type": "string",
      "description": "User bio"
    },
    "avatar_url": {
      "type": "string",
      "description": "User avatar image URL"
    },
    "default_tab": {
      "type": "string",
      "enum": [
        "my",
        "community"
      ],
      "default": "community",
      "description": "Default tab to show on the home page"
    },
    "body_parts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Waist"
      ],
      "description": "Custom body parts tracked for circumference measurements"
    },
    "goal_weight": {
      "type": "number",
      "description": "Target weight in kg"
    },
    "progress_start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date for progress tracking"
    }
  },
  "required": []
}